# Copy this file to .env and fill in real values before running
# `docker compose up`. Never commit the actual .env file.

POSTGRES_USER=alarm_user
POSTGRES_PASSWORD=alarm_password
POSTGRES_DB=alarm_platform

# Generate a real random string for production, e.g.:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string

# Optional -- puzzle generation falls back to a local generator if unset
GEMINI_API_KEY=

# Comma-separated list of extra allowed frontend origins beyond localhost,
# e.g. https://your-frontend.onrender.com
ALLOWED_ORIGINS=

# Must be a URL reachable from the browser (see note in docker-compose.yml)
VITE_API_URL=http://localhost:8000
