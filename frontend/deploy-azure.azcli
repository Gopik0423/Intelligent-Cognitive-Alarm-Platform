#!/bin/bash
# Azure Deployment Script for Cognitive Alarm Frontend
# Run this script using Azure CLI (az)

RESOURCE_GROUP="CognitiveAlarmRG"
APP_SERVICE_PLAN="CognitiveAlarmPlan"
WEB_APP_NAME="cognitive-alarm-frontend-app"
LOCATION="eastus"

# Create a resource group
az group create --name $RESOURCE_GROUP --location $LOCATION

# Create an App Service plan
az appservice plan create --name $APP_SERVICE_PLAN --resource-group $RESOURCE_GROUP --sku B1 --is-linux

# Create a Web App with Docker Hub container as placeholder (can attach to ACR later)
# Assuming image is hosted on Docker Hub or Azure Container Registry
az webapp create --resource-group $RESOURCE_GROUP --plan $APP_SERVICE_PLAN --name $WEB_APP_NAME --deployment-container-image-name youracr.azurecr.io/cognitive-alarm-frontend:latest

# Configure web app to use port 80
az webapp config appsettings set --resource-group $RESOURCE_GROUP --name $WEB_APP_NAME --settings WEBSITES_PORT=80

echo "Deployment configuration scripted. Ensure your container registry credentials are set."
